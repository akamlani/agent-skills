# Package
PACKAGE_NAME=agent-skills
PACKAGE_INSTALL_NAME=agent-skills

# Dotfile repository configuration
GIT_USER=akamlani
DOTFILES_REMOTE=dotfiles
VAULTSPACE_ROOT=$(HOME)/Dropbox/dev-vault/workspace
PACKAGE_DIR=packages/template

# Use HTTPS so clone works without SSH keys; use git@github.com:$(GIT_USER)/dotfiles.git for SSH
DOTFILES_REPO=https://github.com/$(GIT_USER)/$(DOTFILES_REMOTE).git
DOTFILES_DIR=_build/$(DOTFILES_REMOTE)
BRANCH=main

# Claude Plugins
LOCAL_MARKETPLACE = velaristudios-local
LOCAL_PLUGINS     = focus design docgen research finance
PLUGINS_OFFICIAL  = \
    plugin-dev skill-creator playground frontend-design chrome-devtools-mcp \
    feature-dev pyright-lsp typescript-lsp \
    claude-code-setup context7 superpowers code-simplifier code-review \
    github commit-commands pr-review-toolkit \
    data-engineering slack playwright
